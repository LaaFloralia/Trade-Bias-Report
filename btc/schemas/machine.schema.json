 "$comment": "P9 overrides: bias in {0, ±0.25, ±0.5, ±0.75}; confidence 0..1; no_trade_reason null when no_trade is false. Facts and machine times are UTC Z. Semantic checks live in btc/scoring.py and btc/report.py.",
 "allOf": [
  {
   "if": {
    "properties": {
     "no_trade": {
      "const": false
     }
    }
   },
   "then": {
    "properties": {
     "no_trade_reason": {
      "type": "null"
     },
     "btc": {
      "properties": {
       "direction_status": {
        "const": "available"
       },
       "trade_gate": {
        "properties": {
         "status": {
          "const": "clear"
         }
        }
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "no_trade": {
      "const": true
     }
    }
   },
   "then": {
    "properties": {
     "no_trade_reason": {
      "type": "string",
      "pattern": "^(イベント停止|方向付与保留|データ保留|障害停止|期限切れ)"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "btc": {
      "properties": {
       "direction_status": {
        "const": "withheld"
       }
      }
     }
    }
   },
   "then": {
    "properties": {
     "bias": {
      "const": 0
     },
     "no_trade": {
      "const": true
     },
     "confidence": {
      "maximum": 0.2
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "report_kind": {
      "enum": [
       "daily_am",
       "daily_pm"
      ]
     }
    }
   },
   "then": {
    "properties": {
     "mode": {
      "const": "daily"
     }
    }
   },
   "else": {
    "properties": {
     "mode": {
      "const": "weekly"
     },
     "session_slot": {
      "const": "weekly"
     }
    }
   }
  }
 ]
}