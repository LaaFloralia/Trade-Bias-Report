+def test_partial_fedwatch_with_no_known_current_rows_stays_unassessed_and_visible():
+    raw=deepcopy(RAW)
+    raw.update(completeness='partial', target_rates=[], unavailable_target_rates=[
+        {'range':'3.50-3.75','current':None,'prev_day':None,'prev_week':5.2,
+         'availability':'unavailable'},
+        {'range':'3.75-4.00','current':None,'prev_day':None,'prev_week':None,
+         'availability':'unavailable'},
+    ])
+    facts=fedwatch_facts(raw,REF)
+    assert facts['status']=='partial' and facts['distribution_status']=='partial'
+    assert facts['known_current_total_pct']==0
+    assert facts['missing_ranges']==['3.50-3.75','3.75-4.00']
+    assert all(row['current_pct'] is None for row in facts['rows'])
+    report=facts_markdown(facts)
+    assert '全体合計と政策方向別確率は未確定' in report
+    assert '| 3.50-3.75 | 確率欠測 | 取得不可 | 取得不可 | 差分算出不可（提供表 5.2%） |' in report
+    assert '| 3.75-4.00 | 確率欠測 | 取得不可 | 取得不可 | 取得不可 |' in report
