+def test_partial_fedwatch_does_not_assert_known_subtotal():
+    raw=deepcopy(RAW)
+    raw.update(completeness='partial', unavailable_target_rates=[
+        {'range':'3.50-3.75','current':None,'prev_day':None,'prev_week':None}])
+    raw['target_rates']=[
+        {'range':'3.75-4.00','current':40,'prev_day':None,'prev_week':None},
+        {'range':'4.00-4.25','current':40,'prev_day':None,'prev_week':None},
+    ]
+    facts=fedwatch_facts(raw,REF)
+    assert facts['distribution_status']=='partial'
+    assert facts['known_current_total_pct']==80
+
