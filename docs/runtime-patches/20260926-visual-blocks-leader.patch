+LABEL_GAP = 32
+
+
+def spread_labels(targets, top, gap):
+    """Label centres for ascending targets: at least gap apart, each group centred on its targets, never above top."""
+    groups = []  # [first_row, [targets]]
+    for target in targets:
+        groups.append([target, [target]])
+        while True:
+            first, members = groups[-1]
+            first = max(top, sum(members) / len(members) - (len(members) - 1) * gap / 2)
+            groups[-1][0] = first
+            if len(groups) > 1 and groups[-2][0] + len(groups[-2][1]) * gap > first:
+                members = groups.pop()[1]
+                groups[-1][1].extend(members)
+                continue
+            break
+    return [first + i * gap for first, members in groups for i in range(len(members))]
