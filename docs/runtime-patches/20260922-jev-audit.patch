+import json
+import subprocess
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import runner
+
+
+def inputs(tmp_path):
+    source = tmp_path / 'report.md'
+    summary = tmp_path / 'report.summary.json'
+    source.write_text('A reduction is possible if inflation declines.')
+    summary.write_text(json.dumps({'conclusion': {
+        'text': 'A reduction will happen.', 'source_quote': source.read_text()}}))
+    return source, summary
+
+
+def test_local_summary_never_loads_credentials(tmp_path, monkeypatch):
+    source, summary = inputs(tmp_path)
+    monkeypatch.setattr(runner.subprocess, 'run', lambda *a, **k: pytest.fail('Unexpected credential/API process'))
+    audit = json.loads(Path(runner.audit_report_summary(source, summary)).read_text())
+    assert audit['pairs'][0]['result'] == 'unassessed'
+    assert audit['api']['request_count'] == 0
+    assert audit['scope']['source_fact_verification'] is False
+
+
+def test_disabled_public_summary_does_not_call_api(tmp_path, monkeypatch):
+    source, summary = inputs(tmp_path)
+    monkeypatch.setenv('LAA_JEV_DISABLED', '1')
+    monkeypatch.setattr(runner.subprocess, 'run', lambda *a, **k: pytest.fail('Unexpected credential/API process'))
+    audit = json.loads(Path(runner.audit_report_summary(source, summary, 'public')).read_text())
+    assert audit['api']['reason'] == 'disabled'
+
+
+def test_worker_timeout_retains_unknown_usage_and_unassessed_pair(tmp_path, monkeypatch):
+    source, summary = inputs(tmp_path)
+    monkeypatch.delenv('LAA_JEV_DISABLED', raising=False)
+    monkeypatch.setattr(Path, 'is_file', lambda _: True)
+    def fail(*args, **kwargs):
+        assert kwargs['timeout'] == 25
+        assert 'TYPESAFE_API_KEY' not in kwargs['env']
+        raise subprocess.TimeoutExpired('redacted', 25)
+    monkeypatch.setattr(runner.subprocess, 'run', fail)
+    audit = json.loads(Path(runner.audit_report_summary(source, summary, 'public')).read_text())
+    assert audit['api']['reason'] == 'audit_worker_unavailable'
+    assert audit['api']['request_count'] is None
+    assert audit['pairs'][0]['result'] == 'unassessed'
+
+
+def test_worker_cannot_omit_an_audited_pair(tmp_path, monkeypatch):
+    from scripts.jev_report_audit import audit_summary
+    source, summary = inputs(tmp_path)
+    monkeypatch.delenv('LAA_JEV_DISABLED', raising=False)
+    monkeypatch.setattr(Path, 'is_file', lambda _: True)
+    malformed = audit_summary(json.loads(summary.read_text()), source.read_text())
+    malformed['pairs'] = []
+    def fake(*args, **kwargs):
+        source.with_suffix('.semantic-audit.json').write_text(json.dumps(malformed))
+        return SimpleNamespace(returncode=0)
+    monkeypatch.setattr(runner.subprocess, 'run', fake)
+    audit = json.loads(Path(runner.audit_report_summary(source, summary, 'public')).read_text())
+    assert audit['api']['reason'] == 'audit_worker_unavailable'
+    assert len(audit['pairs']) == 1
