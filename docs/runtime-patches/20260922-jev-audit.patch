+def audit_report_summary(md_path, summary_path, data_class='local'):
+    """Bounded auxiliary check of public summary/quote pairs, never acceptance."""
+    from scripts.jev_report_audit import audit_summary
+    md_path, summary_path = Path(md_path), Path(summary_path)
+    source = md_path.read_text(encoding='utf-8')
+    summary = json.loads(summary_path.read_text(encoding='utf-8'))
+    fallback = audit_summary(summary, source, mode='code')
+    target = md_path.with_suffix('.semantic-audit.json')
+    result = fallback
+    started = time.monotonic()
+    if data_class not in {'public', 'local'}:
+        raise ValueError('Summary data class must be public or local')
+    semantic_candidates = any(pair.get('result') == 'unassessed' for pair in fallback['pairs'])
+    deterministic_error = any(pair.get('result') == 'deterministic_error' for pair in fallback['pairs'])
+    if os.environ.get('LAA_JEV_DISABLED') == '1':
+        fallback['api']['reason'] = 'disabled'
+    if (data_class == 'public' and os.environ.get('LAA_JEV_DISABLED') != '1'
+            and semantic_candidates and not deterministic_error):
+        template = Path.home() / '.config/laa/typesafe.env.tpl'
+        wrapper = Path.home() / '.config/laa/op-run-batch.sh'
+        if template.is_file() and wrapper.is_file():
+            command = [str(wrapper), str(template), str(PYTHON), '-B',
+                       str(RUNTIME / 'scripts/jev_report_audit.py'),
+                       '--source', str(md_path), '--summary', str(summary_path),
+                       '--output', str(target), '--mode', 'jev', '--data-class', 'public']
+            try:
+                proc = subprocess.run(command, capture_output=True, timeout=25,
+                    env={'HOME': str(Path.home()), 'USER': os.environ.get('USER', 'laa'),
+                         'PATH': '/opt/homebrew/bin:/usr/bin:/bin', 'PYTHONDONTWRITEBYTECODE': '1'})
+                if proc.returncode != 0:
+                    raise RuntimeError('Auxiliary audit worker failed')
+                candidate = json.loads(target.read_text(encoding='utf-8'))
+                identity = lambda pair: tuple(pair.get(k) for k in
+                    ('id', 'text', 'source_quote', 'deterministic_status'))
+                if (not isinstance(candidate, dict) or candidate.get('schema_version') != 1 or
+                        candidate.get('source_sha256') != fallback['source_sha256'] or
+                        candidate.get('summary_sha256') != fallback['summary_sha256'] or
+                        not isinstance(candidate.get('pairs'), list) or
+                        not all(isinstance(pair, dict) for pair in candidate['pairs']) or
+                        [identity(pair) for pair in candidate['pairs']] !=
+                        [identity(pair) for pair in fallback['pairs']]):
+                    raise ValueError('Auxiliary audit input mismatch')
+                result = candidate
+            except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired):
+                # Do not expose arbitrary credential or API error text. A killed
+                # worker may have called the API; its shared reservation remains.
+                result['api'].update(status='fallback', reason='audit_worker_unavailable', request_count=None)
+        else:
+            result['api'].update(status='local_only', reason='credential_wrapper_unavailable')
+    result['total_elapsed_ms'] = round((time.monotonic() - started) * 1000, 3)
+    target.write_text(json.dumps(result, ensure_ascii=False, allow_nan=False, indent=2) + '\n')
+    target.chmod(0o600)
+    return str(target)
 
 
